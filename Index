<!DOCTYPE html>
<html>
<head><title>Simple AI Flower Classifier</title></head>
<body>
  <h2>Flower Classifier (Rule-Based AI)</h2>
  <label>Petal Length: <input id="length" type="number"></label><br><br>
  <label>Petal Width: <input id="width" type="number"></label><br><br>
  <button onclick="classify()">Predict</button>
  <p id="result"></p>

  <script>
    function classify() {
      let length = parseFloat(document.getElementById("length").value);
      let width = parseFloat(document.getElementById("width").value);
      let result;
      if (length < 2) {
        result = "Setosa";
      } else if (width < 1.8) {
        result = "Versicolor";
      } else {
        result = "Virginica";
      }
      document.getElementById("result").innerText = "Prediction: " + result;
    }
  </script>
</body>
</html>
